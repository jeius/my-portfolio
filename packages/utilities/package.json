{
  "name": "@jeius-portfolio/utilities",
  "version": "1.2.0",
  "description": "Shared utilities for the portfolio",
  "private": true,
  "author": "Julius Pahama <www.linkedin.com/in/julius-pahama>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./extractors": {
      "types": "./dist/extractors/index.d.ts",
      "default": "./dist/extractors/index.js"
    },
    "./filters": {
      "types": "./dist/filters/index.d.ts",
      "default": "./dist/filters/index.js"
    },
    "./formatters": {
      "types": "./dist/formatters/index.d.ts",
      "default": "./dist/formatters/index.js"
    },
    "./transformers": {
      "types": "./dist/transformers/index.d.ts",
      "default": "./dist/transformers/index.js"
    },
    "./type-guards": {
      "types": "./dist/type-guards/index.d.ts",
      "default": "./dist/type-guards/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "dev:safe": "pnpm dev",
    "lint": "eslint .",
    "lint:fix": "eslint --fix . && prettier --write ."
  },
  "devDependencies": {
    "@jeius-portfolio/enums": "workspace:*",
    "@jeius-portfolio/eslint-config": "workspace:*",
    "@jeius-portfolio/types": "workspace:*",
    "@jeius-portfolio/typescript-config": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.0",
    "payload": "3.85.1"
  },
  "peerDependencies": {
    "@jeius-portfolio/enums": "workspace:*",
    "@jeius-portfolio/types": "workspace:*",
    "lodash-es": "^4.18.1",
    "payload": "3.85.1"
  }
}
