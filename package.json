{
  "name": "jeius-portfolio",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:frontend": "turbo run build --filter=@jeius-portfolio/frontend",
    "build:backend": "turbo run build --filter=@jeius-portfolio/backend",
    "build:packages": "turbo run build --filter=\"{./packages/*}...\"",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "dev:site": "turbo run dev --filter=@jeius-portfolio/frontend --filter=@jeius-portfolio/backend",
    "dev:frontend": "turbo run dev --filter=@jeius-portfolio/frontend",
    "dev:backend": "turbo run dev --filter=@jeius-portfolio/backend",
    "dev:packages": "turbo run dev --filter=\"{./packages/*}...\"",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.9.4",
    "turbo": "^2.10.4"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
  "engines": {
    "node": ">=24"
  }
}
